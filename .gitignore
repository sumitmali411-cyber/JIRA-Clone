# Root gitignore

# IDE
.idea/
.vscode/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Environment
.env
.env.local

# ── Frontend ──────────────────────────────────────────────
node_modules/
jira-clone-frontend/dist/
jira-clone-frontend/.angular/
jira-clone-frontend/coverage/

# ── Backend ───────────────────────────────────────────────
jira-clone-backend/target/

# ── Keycloak exported data ────────────────────────────────
keycloak-data/

# ── K8s secrets (real passwords — keep local, use *.example for git) ──────
k8s/01-secrets.yaml

# ── Load test temp / k6 results ───────────────────────────────────────────
load-tests/*.json
load-tests/*.csv

# ── Frontend proxy temp file (generated by start.js) ─────────────────────
jira-clone-frontend/.proxy.conf.tmp.json
