# Copy to .env (git-ignored) and fill in. Never commit real values.

# MySQL
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_URL=jdbc:mysql://localhost:3306/jiraclone?useSSL=true&requireSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/jira-clone

# GitHub webhook signing secret.
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Origin allowed to call the API
FRONTEND_ORIGIN=http://localhost:4200

# Swagger UI / api-docs are permitAll. Set false on any deployed environment.
SWAGGER_ENABLED=true
