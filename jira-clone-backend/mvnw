# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script
# ----------------------------------------------------------------------------

set -e

# Find the project base dir, i.e. the directory that contains the folder ".mvn".
find_maven_basedir() {
  if [ -z "$1" ]
  then
    echo "Path not specified to find_maven_basedir"
    return 1
  fi
  basedir="$1"
  wdir="$1"
  while [ "$wdir" != '/' ] ; do
    if [ -d "$wdir"/.mvn ] ; then
      basedir=$wdir
      break
    fi
    # workaround for JBEAP-8937 (on Solaris 10/Sparc)
    if [ -d "${wdir}" ]; then
      wdir=$(cd "$wdir/.." || exit 1; pwd)
    fi
    # end of workaround
  done
  printf '%s' "$(cd "$basedir" || exit 1; pwd)"
}

# concatenates all lines of a file
concat_lines() {
  if [ -f "$1" ]; then
    echo "$(tr -s '\n' ' ' < "$1")"
  fi
}

log() {
  if [ "$MVNW_VERBOSE" = true ]; then
    printf '%s\n' "$1"
  fi
}

BASE_DIR=$(find_maven_basedir "$(dirname "$0")")
if [ -z "$BASE_DIR" ]; then
  exit 1;
fi

MAVEN_PROJECTBASEDIR=${MAVEN_BASEDIR:-"$BASE_DIR"}; export MAVEN_PROJECTBASEDIR
log "$MAVEN_PROJECTBASEDIR"

##########################################################################################
# Extension to allow automatically downloading the maven-wrapper.jar from Maven-central
# This allows using the maven-wrapper.jar for the first time without adding it to SCM.
##########################################################################################
if [ -r "$BASE_DIR/.mvn/wrapper/maven-wrapper.jar" ]; then
    log "Found .mvn/wrapper/maven-wrapper.jar"
else
    log "Couldn't find .mvn/wrapper/maven-wrapper.jar, downloading it ..."
    if command -v wget > /dev/null; then
        wrapperUrl=$(grep 'wrapperUrl' "$BASE_DIR/.mvn/wrapper/maven-wrapper.properties" | cut -d'=' -f2)
        while IFS="=" read -r key value; do
          case "$key" in (wrapperUrl) wrapperUrl="$value"; break ;;
        esac
        done < "$BASE_DIR/.mvn/wrapper/maven-wrapper.properties"
        log "Downloading from: $wrapperUrl"
        if [ "$MVNW_VERBOSE" = true ]; then
          wget "$wrapperUrl" -v -O "$BASE_DIR/.mvn/wrapper/maven-wrapper.jar" || rm -f "$BASE_DIR/.mvn/wrapper/maven-wrapper.jar"
        else
          wget "$wrapperUrl" -q -O "$BASE_DIR/.mvn/wrapper/maven-wrapper.jar" || rm -f "$BASE_DIR/.mvn/wrapper/maven-wrapper.jar"
        fi
    elif command -v curl > /dev/null; then
        wrapperUrl=$(grep 'wrapperUrl' "$BASE_DIR/.mvn/wrapper/maven-wrapper.properties" | cut -d'=' -f2)
        while IFS="=" read -r key value; do
          case "$key" in (wrapperUrl) wrapperUrl="$value"; break ;;
        esac
        done < "$BASE_DIR/.mvn/wrapper/maven-wrapper.properties"
        log "Downloading from: $wrapperUrl"
        if [ "$MVNW_VERBOSE" = true ]; then
          curl -v -o "$BASE_DIR/.mvn/wrapper/maven-wrapper.jar" "$wrapperUrl" || rm -f "$BASE_DIR/.mvn/wrapper/maven-wrapper.jar"
        else
          curl -q -o "$BASE_DIR/.mvn/wrapper/maven-wrapper.jar" "$wrapperUrl" || rm -f "$BASE_DIR/.mvn/wrapper/maven-wrapper.jar"
        fi
    else
        echo "There is no wget or curl available. Please install one of them to download the Maven wrapper JAR."
        exit 1
    fi
fi
##########################################################################################
# End of extension
##########################################################################################

MAVEN_OPTS="$(concat_lines "$MAVEN_PROJECTBASEDIR/.mvn/jvm.config") $MAVEN_OPTS"

# shellcheck disable=SC2086 # safe args
exec "$JAVACMD" \
  $MAVEN_OPTS \
  $MAVEN_DEBUG_OPTS \
  -classpath "$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar" \
  "-Dmaven.multiModuleProjectDirectory=${MAVEN_PROJECTBASEDIR}" \
  org.apache.maven.wrapper.MavenWrapperMain "$@"
